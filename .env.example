# CURVIN frontend environment — copy to .env.local for development.
# Never commit real secrets. Every NEXT_PUBLIC_ value is visible in the browser bundle.

# Feature flag: "true" serves the UI from local mock service adapters (clearly
# labelled demo data, no network). "false" requires a running CURVIN backend at
# NEXT_PUBLIC_API_BASE_URL. The service layer (src/services) switches automatically.
NEXT_PUBLIC_USE_MOCKS=true

# CURVIN backend API base URL, no trailing slash. Example:
# https://api.curvin.dev
NEXT_PUBLIC_API_BASE_URL=

# Optional public analytics identifier (server-injected providers preferred).
NEXT_PUBLIC_ANALYTICS_ID=
