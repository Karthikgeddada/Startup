# CURVIN backend — copy to .env and fill in only what you need.
# Nothing here is required to boot: missing values fall back to local dev
# defaults (SQLite, permissive CORS). Never commit a real .env.

# development | production
ENVIRONMENT=development

# SQLite by default. For Postgres (Supabase/Render) use e.g.
# postgresql+psycopg2://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./curvin.db

# The frontend origin (enables credentialed CORS). Required in production.
FRONTEND_URL=http://localhost:3000

# Session/auth secret (Phase 1 placeholder; real auth lands later).
AUTH_SECRET=

# Model gateway (Phase 2) — bring your own key, server-side only.
# The backend never proxies keys to browsers. Any OpenAI-compatible endpoint
# works (OpenAI, OpenRouter, Groq, Together, vLLM, llama.cpp server, ...).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Optional per-role overrides — every role falls back to LLM_MODEL.
# Roles: fast (cheap classification), planning, code, verification, embedding.
LLM_FAST_MODEL=
LLM_PLANNING_MODEL=
LLM_CODE_MODEL=
LLM_VERIFICATION_MODEL=
LLM_EMBEDDING_MODEL=

# Gateway behaviour (defaults shown).
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# Per-run agent budgets (bounded loops — defaults shown).
# AGENT_MAX_LLM_CALLS=40
# AGENT_MAX_TOTAL_TOKENS=200000

# GitHub integration (optional). Without a token /api/v1/github/repositories
# returns an honest empty list — never fabricated repositories.
GITHUB_TOKEN=

# curvin-runner dispatch (Phase 4 — defaults shown).
# RUNNER_ONLINE_WINDOW_SECONDS=30
# RUNNER_JOB_TIMEOUT_SECONDS=120
# RUNNER_POLL_INTERVAL_SECONDS=0.5
